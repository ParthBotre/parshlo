{
  "name": "parshlo",
  "version": "0.1.0",
  "private": true,
  "description": "Parshlo — enterprise pharmaceutical B2B ordering platform (monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "pnpm --filter @parshlo/db generate",
    "db:migrate": "pnpm --filter @parshlo/db migrate",
    "db:seed": "pnpm --filter @parshlo/db seed",
    "db:studio": "pnpm --filter @parshlo/db studio",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.2",
      "esbuild": ">=0.25.0",
      "fast-xml-parser": ">=4.5.4",
      "postcss": ">=8.5.10",
      "prismjs": ">=1.30.0",
      "@eslint/plugin-kit": ">=0.3.4",
      "vite": "6.4.2",
      "yaml": ">=2.8.3"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@types/node": "22.10.5",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  }
}
