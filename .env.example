# =========================================================================
# Parshlo — Root .env.example
# Copy to .env (gitignored) and fill in for local development.
# Apps may have their own .env.example — those take precedence inside the app.
# =========================================================================

# ----- Core -----
NODE_ENV=development
LOG_LEVEL=debug

# ----- Database (Postgres) -----
# Used by @parshlo/db (Prisma) and apps/api
POSTGRES_USER=parshlo
POSTGRES_PASSWORD=parshlo_dev
POSTGRES_DB=parshlo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://parshlo:parshlo_dev@localhost:5432/parshlo?schema=public

# ----- Redis (sessions, rate limit, BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- Auth -----
# Two supported modes:
#   AUTH_MODE=dev    → HS256 cookies signed by AUTH_DEV_SECRET; sign-in via seeded personas.
#                      Use locally / in CI / for resume demos — no Auth0 tenant needed.
#   AUTH_MODE=auth0  → real Auth0 OIDC with JWKS-verified RS256 tokens.
AUTH_MODE=dev
AUTH_DEV_SECRET=replace-with-openssl-rand-hex-32-or-better

# ----- Auth0 (required when AUTH_MODE=auth0) -----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.parshlo.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=replace-with-openssl-rand-hex-32
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_LOGIN_ROUTE=/api/auth/login

# ----- AWS / S3 (disabled by default) -----
# Keep STORAGE_ENABLED=false until uploads are intentionally launched.
STORAGE_ENABLED=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_KYC=
S3_BUCKET_INVOICES=
# For local dev, LocalStack endpoint:
S3_ENDPOINT=

# ----- Email (disabled by default) -----
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Parshlo <no-reply@parshlo.local>"
EMAIL_REPLY_TO=support@parshlo.local

# ----- App URLs -----
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ----- Security -----
# Comma-separated list of allowed origins for CORS in the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Observability -----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ----- Feature flags -----
FEATURE_FLAGS_PROVIDER=local
# Invoice generation is deferred. Keep this false until invoice numbering,
# S3 buckets, and stakeholder-approved invoice rules are ready.
INVOICE_GENERATION_ENABLED=false
