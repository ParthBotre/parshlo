{
  "name": "@parshlo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Parshlo backend API (NestJS + Fastify)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.717.0",
    "@aws-sdk/s3-request-presigner": "3.717.0",
    "@fastify/compress": "8.0.1",
    "@fastify/cookie": "11.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "11.1.20",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.20",
    "@nestjs/platform-fastify": "11.1.20",
    "@nestjs/swagger": "11.4.2",
    "@nestjs/throttler": "6.5.0",
    "@parshlo/db": "workspace:*",
    "@parshlo/logger": "workspace:*",
    "@parshlo/queue": "workspace:*",
    "@parshlo/telemetry": "workspace:*",
    "@parshlo/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.8.5",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0",
    "nestjs-pino": "4.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.20",
    "@parshlo/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
}
