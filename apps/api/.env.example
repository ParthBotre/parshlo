NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://parshlo:parshlo_dev@localhost:5432/parshlo?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth — AUTH_DEV_SECRET must match root .env and apps/web/.env.local in dev mode.
# Prefer setting it only in the repo-root .env; this file is optional overrides.
AUTH_MODE=dev
AUTH_DEV_SECRET=replace-with-openssl-rand-hex-32-or-better

# Auth0 (only when AUTH_MODE=auth0)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.parshlo.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_SECRET=replace-with-openssl-rand-hex-32

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS S3
AWS_REGION=ap-south-1
S3_BUCKET_KYC=parshlo-kyc-dev
S3_BUCKET_INVOICES=parshlo-invoices-dev
S3_ENDPOINT=http://localhost:4566

# Email
RESEND_API_KEY=
EMAIL_FROM="Parshlo <no-reply@parshlo.local>"
