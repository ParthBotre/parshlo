NODE_ENV=development

# Public API endpoint used by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Server-side API base (RSC, route handlers) — defaults to NEXT_PUBLIC_* if not set
API_BASE_URL=http://localhost:4000

# Auth — see root .env.example
AUTH_MODE=dev
AUTH_DEV_SECRET=replace-with-openssl-rand-hex-32-or-better

# Auth0 (only when AUTH_MODE=auth0)
AUTH0_SECRET=replace-with-openssl-rand-hex-32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.parshlo.local
AUTH0_SCOPE="openid profile email"
NEXT_PUBLIC_LOGIN_ROUTE=/api/auth/login

# Web app base URL (used by /api/auth/logout to redirect)
WEB_BASE_URL=http://localhost:3000

# Feature flags
# - PRICING_ENABLED: when false, prices show as "—" everywhere and the
#   "Place order" button is disabled. Flip to true once wholesale rates are
#   finalised in the product master.
# Set to false to hide prices and disable checkout (production until rates are final).
NEXT_PUBLIC_PRICING_ENABLED=true
