NODE_ENV=development
DATABASE_URL=postgresql://parshlo:parshlo@localhost:5432/parshlo?schema=public
REDIS_URL=redis://localhost:6379

# Email transport
EMAIL_TRANSPORT=mailhog        # mailhog | resend
EMAIL_FROM=Parshlo <no-reply@parshlo.local>
RESEND_API_KEY=
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# S3 (LocalStack in dev)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_INVOICES=parshlo-invoices-dev

# Feature flags
INVOICE_GENERATION_ENABLED=false

# Concurrency
WORKER_CONCURRENCY_EMAIL=10
WORKER_CONCURRENCY_INVOICE=4
WORKER_CONCURRENCY_KYC=4
