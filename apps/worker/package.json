{
  "name": "@parshlo/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job processor: emails, invoice PDFs, KYC notifications",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.cjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.717.0",
    "@aws-sdk/s3-request-presigner": "3.717.0",
    "@parshlo/db": "workspace:*",
    "@parshlo/logger": "workspace:*",
    "@parshlo/queue": "workspace:*",
    "@parshlo/telemetry": "workspace:*",
    "@parshlo/types": "workspace:*",
    "@react-email/components": "0.0.32",
    "@react-email/render": "1.0.4",
    "bullmq": "5.34.6",
    "ioredis": "5.4.2",
    "nodemailer": "6.9.16",
    "pdf-lib": "1.17.1",
    "react": "19.0.0",
    "resend": "4.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@parshlo/config": "workspace:*",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.0.2",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
