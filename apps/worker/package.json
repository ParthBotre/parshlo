{
  "name": "@parshlo/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job processor: emails, invoice PDFs, KYC notifications",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.cjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1047.0",
    "@aws-sdk/s3-request-presigner": "3.1047.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.7.1",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@parshlo/db": "workspace:*",
    "@parshlo/logger": "workspace:*",
    "@parshlo/queue": "workspace:*",
    "@parshlo/telemetry": "workspace:*",
    "@parshlo/types": "workspace:*",
    "@react-email/components": "0.0.32",
    "@react-email/render": "1.0.4",
    "@sentry/node": "8.49.0",
    "bullmq": "5.34.6",
    "dotenv": "17.4.2",
    "ioredis": "5.4.2",
    "nodemailer": "8.0.7",
    "pdf-lib": "1.17.1",
    "prom-client": "15.1.3",
    "react": "19.0.1",
    "resend": "4.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@parshlo/config": "workspace:*",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.0.2",
    "tsup": "8.5.1",
    "tsx": "4.22.0",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
