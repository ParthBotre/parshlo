{
  "name": "@parshlo/logger",
  "version": "0.1.0",
  "private": true,
  "description": "Structured logger (Pino) with redaction, request-id propagation, and pretty dev output",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "source": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "pino-pretty": "13.0.0"
  },
  "devDependencies": {
    "@parshlo/config": "workspace:*",
    "@types/node": "22.10.5",
    "tsup": "8.3.5",
    "typescript": "5.7.3"
  }
}
