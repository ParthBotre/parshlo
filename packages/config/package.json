    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-unicorn": "56.0.1",
    "globals": "15.14.0",
    "tailwindcss": "3.4.17",
    "typescript-eslint": "8.19.1"
