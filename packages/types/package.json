{
  "name": "@parshlo/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas and TypeScript types (source of truth for API contracts)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@parshlo/config": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
