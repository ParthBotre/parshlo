{
  "name": "@parshlo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and typed client for the Parshlo platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "prisma",
    "README.md"
  ],
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsup",
    "dev": "tsup --watch",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@parshlo/config": "workspace:*",
    "@types/node": "22.10.5",
    "dotenv-cli": "8.0.0",
    "prisma": "5.22.0",
    "tsup": "8.5.1",
    "tsx": "4.22.0",
    "typescript": "5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
