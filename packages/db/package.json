{
  "name": "@parshlo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and typed client for the Parshlo platform",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "source": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "prisma", "README.md"],
  "scripts": {
    "build": "prisma generate && tsup",
    "dev": "tsup --watch",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@parshlo/config": "workspace:*",
    "@types/node": "22.10.5",
    "prisma": "5.22.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
