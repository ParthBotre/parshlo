{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env.*local",
    "**/.env",
    "tsconfig.base.json",
    "packages/config/**"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "AUTH0_*",
        "REDIS_URL",
        "SENTRY_*",
        "AWS_*",
        "S3_*",
        "RESEND_API_KEY",
        "API_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["**/*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV", "DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@parshlo/db#build": {
      "dependsOn": ["@parshlo/db#generate"],
      "inputs": ["src/**", "prisma/schema.prisma", "tsup.config.ts", "tsconfig.json"],
      "outputs": ["dist/**", "node_modules/.prisma/**", "../../node_modules/.prisma/**"]
    },
    "@parshlo/db#generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["node_modules/.prisma/**", "../../node_modules/.prisma/**"]
    },
    "@parshlo/db#migrate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"]
    }
  }
}
